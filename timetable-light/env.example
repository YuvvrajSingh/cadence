# Where Next.js proxies /api/* (server-side). Default is http://127.0.0.1:3001 — do not set this to the Next URL (3000).
API_BACKEND_URL=http://127.0.0.1:3001

# Optional: only if you disable rewrites and call the API host directly from the browser
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

# Must match time-table-backend JWT_SECRET (middleware verifies the session cookie)
JWT_SECRET=change-me-to-a-long-random-string
